{
  "name": "evolco-vue-gantt",
  "version": "2.2.2",
  "description": "Modification of the frappe gantt",
  "main": "src/index.js",
  "files": ["src", "dist", "index.html", "README.md", "license.txt"],
  "scripts": {
    "start": "npm run dev",
    "build": "rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs -w",
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "lint": "eslint src tests rollup.config.mjs eslint.config.mjs",
    "prettier": "prettier --write \"src/**/*.{js,scss}\" \"tests/**/*.mjs\" \"*.mjs\"",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evolvoltd/evolco-vue-gantt"
  },
  "keywords": [
    "gantt",
    "vue",
    "svg",
    "simple gantt",
    "project timeline",
    "interactive gantt",
    "project management"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/evolvoltd/evolco-vue-gantt/issues"
  },
  "homepage": "https://github.com/evolvoltd/evolco-vue-gantt",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.5",
    "sass": "^1.105.1"
  },
  "dependencies": {
    "date-fns": "^2.30.0"
  }
}
